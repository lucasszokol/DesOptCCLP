{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project 4 heat-sink results",
  "type": "object",
  "required": ["schema_version", "status", "units", "geometry", "designs", "optimization_history", "verification"],
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "power_w", "ambient_k", "limit_k", "ks_temperature_k", "chip_peak_temperature_k", "scaled_constraint", "passed", "energy_imbalance_w", "newton_iterations"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "power_w": {"type": "number", "exclusiveMinimum": 0},
        "limit_k": {"type": "number", "exclusiveMinimum": 0},
        "ks_temperature_k": {"type": "number"},
        "chip_peak_temperature_k": {"type": "number"},
        "scaled_constraint": {"type": "number"},
        "passed": {"type": "boolean"},
        "energy_imbalance_w": {"type": "number"}
      }
    },
    "design": {
      "type": "object",
      "required": ["name", "mass_kg", "heights_m", "densities", "base_temperature_k", "fin_temperature_k", "load_cases"],
      "properties": {
        "mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "heights_m": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "densities": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "base_temperature_k": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "fin_temperature_k": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": {"type": "number"}}},
        "load_cases": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/case"}}
      }
    },
    "uncertainty_gradient_sample": {
      "type": "object",
      "required": ["step", "central_difference", "relative_error"],
      "properties": {
        "step": {"type": "number", "exclusiveMinimum": 0},
        "central_difference": {"type": "number"},
        "relative_error": {"type": "number", "minimum": 0}
      }
    },
    "uncertainty_gradient_check": {
      "type": "object",
      "required": ["scenario", "variable_family", "adjoint", "central_difference", "relative_error", "step", "selection_method", "step_sweep"],
      "properties": {
        "scenario": {"type": "string", "minLength": 1},
        "variable_family": {"enum": ["height", "density"]},
        "adjoint": {"type": "number"},
        "central_difference": {"type": "number"},
        "relative_error": {"type": "number", "minimum": 0},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "selection_method": {"type": "string", "minLength": 1},
        "step_sweep": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/uncertainty_gradient_sample"}}
      }
    },
    "topology_start": {
      "type": "object",
      "required": ["name", "success", "message", "mass_kg", "max_raw_scaled_constraint", "max_buffered_scaled_constraint", "raw_densities", "filtered_densities"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "success": {"type": "boolean"},
        "message": {"type": "string"},
        "mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "max_raw_scaled_constraint": {"type": "number"},
        "max_buffered_scaled_constraint": {"type": "number"},
        "raw_densities": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "filtered_densities": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}}
      }
    },
    "topology_summary": {
      "type": "object",
      "required": ["candidate_fins", "active_fins_after_threshold", "all_candidate_fins_retained", "binary_density", "threshold_filtered_density", "intermediate_binary_density_count_0p01_0p99", "intermediate_filtered_density_count_0p01_0p99", "threshold_reoptimization_feasible", "discrete_removed_fin_feasibility_demonstrated", "topology_bonus_demonstrated"],
      "properties": {
        "candidate_fins": {"type": "integer", "minimum": 1},
        "active_fins_after_threshold": {"type": "integer", "minimum": 0},
        "all_candidate_fins_retained": {"type": "boolean"},
        "binary_density": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "threshold_filtered_density": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "intermediate_binary_density_count_0p01_0p99": {"type": "integer", "minimum": 0},
        "intermediate_filtered_density_count_0p01_0p99": {"type": "integer", "minimum": 0},
        "threshold_reoptimization_feasible": {"type": "boolean"},
        "discrete_removed_fin_feasibility_demonstrated": {"type": "boolean"},
        "topology_bonus_demonstrated": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["awaiting_human_gate", "verified", "final"]},
    "model_configuration": {"type": "object", "required": ["geometry", "physics", "load_cases"]},
    "thermal_dofs": {"type": "integer", "minimum": 1},
    "units": {"type": "object"},
    "geometry": {
      "type": "object",
      "required": ["base_width_m", "base_depth_m", "base_thickness_m", "fin_thickness_m", "fin_x_m", "base_elements_x", "base_elements_z"]
    },
    "designs": {
      "type": "object",
      "required": ["initial", "optimized"],
      "properties": {
        "initial": {"$ref": "#/$defs/design"},
        "optimized": {"anyOf": [{"$ref": "#/$defs/design"}, {"type": "null"}]}
      }
    },
    "optimization_history": {"type": "array"},
    "verification": {"type": "object"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "final"}}, "required": ["status"]},
    "then": {
      "required": ["model_configuration", "thermal_dofs", "gradient_checks", "sensitivity_cost", "kkt", "topology_starts", "topology_summary", "uncertainty"],
      "properties": {
        "designs": {"required": ["optimized", "linear_fixed", "nonlinear_fixed"], "properties": {"optimized": {"$ref": "#/$defs/design"}, "linear_fixed": {"$ref": "#/$defs/design"}, "nonlinear_fixed": {"$ref": "#/$defs/design"}}},
        "optimization_history": {"type": "array", "minItems": 1},
        "verification": {"type": "object", "required": ["status", "groups"], "properties": {"status": {"const": "passed"}, "groups": {"type": "array", "minItems": 6}}},
        "gradient_checks": {"type": "array", "minItems": 4},
        "topology_starts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/topology_start"}},
        "topology_summary": {"$ref": "#/$defs/topology_summary"},
        "kkt": {"type": "object", "required": ["success", "optimality", "physical_stationarity_inf_norm", "constraint_violation", "constraint_complementarity", "bound_complementarity", "multipliers"], "properties": {"success": {"const": true}}},
        "uncertainty": {"type": "object", "required": ["assumptions", "design", "baseline_design", "optimizer_success", "gradient_checks"], "properties": {"design": {"$ref": "#/$defs/design"}, "baseline_design": {"$ref": "#/$defs/design"}, "optimizer_success": {"const": true}, "gradient_checks": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/uncertainty_gradient_check"}}}}
      }
    }
  }]
}
